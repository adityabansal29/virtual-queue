# Copy to .env for local development.
# ADMISSION_SECRET and SESSION_SECRET MUST differ — server panics at startup if they are equal.

REDIS_ADDR=redis-queue:6379
PORT=8080
ADMISSION_SECRET=dev-admission-secret-change-in-prod
SESSION_SECRET=dev-session-secret-change-in-prod
SSE_THRESHOLD=200
DEFAULT_EVENT_ID=evt-001
DEFAULT_ADMIT_RATE=60
